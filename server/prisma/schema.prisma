datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HOD
  FACULTY

  @@map("role_type")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}



model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  code      String     @unique // e.g. "CS", "MATH"
  users     User[]
  deadlines Deadline[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  supabaseUserId String         @unique @db.Uuid @map("supabase_user_id")
  email          String         @unique
  fullName       String         @map("full_name")
  role           Role           @default(FACULTY)
  departmentId   String         @db.Uuid @map("department_id")
  department     Department     @relation(fields: [departmentId], references: [id])
  avatarUrl      String?        @map("avatar_url")
  deadlines      Deadline[]     @relation("CreatedDeadlines")
  notifications  Notification[]
  pushTokens     PushToken[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  
  // New fields appended to the end
  employeeCode   String?        @map("employee_code")
  isSuspended    Boolean        @default(false) @map("is_suspended")
  googleAccount  GoogleAccount?
  calendarEvents CalendarEvent[]
  reminders      Reminder[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Deadline {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String
  dueDate        DateTime        @map("due_date")
  priority       Priority        @default(MEDIUM)
  ownerId        String          @db.Uuid @map("owner_id")
  owner          User            @relation("CreatedDeadlines", fields: [ownerId], references: [id], onDelete: Cascade)
  departmentId   String          @db.Uuid @map("department_id")
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isCompleted    Boolean         @default(false) @map("is_completed")
  status         String          @default("ACTIVE")
  notifications  Notification[]
  reminders      Reminder[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("deadlines")
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  body              String
  type              String    @default("DEADLINE")
  isRead            Boolean   @default(false) @map("is_read")
  relatedDeadlineId String?   @db.Uuid @map("related_deadline_id")
  relatedDeadline   Deadline? @relation(fields: [relatedDeadlineId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String   @unique @map("fcm_token")
  platform  String   @map("platform")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_tokens")
}

model GoogleAccount {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId     String   @unique @map("google_id")
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  syncGmail    Boolean  @default(false) @map("sync_gmail")
  syncCalendar Boolean  @default(false) @map("sync_calendar")
  connectedAt  DateTime @default(now()) @map("connected_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_accounts")
}

model CalendarEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEventId String?  @unique @map("google_event_id")
  title         String
  description   String?
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  eventType     String   @default("GENERAL") @map("event_type")
  source        String   @default("APP") // "APP" or "GOOGLE"
  deadlineId    String?  @db.Uuid @map("deadline_id")
  deadline      Deadline? @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("calendar_events")
}

model Reminder {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  reminderTime DateTime @map("reminder_time")
  repeatType   String   @default("NONE") @map("repeat_type")
  status       String   @default("PENDING") // "PENDING", "SENT", "DISMISSED"
  deadlineId   String?  @db.Uuid @map("deadline_id")
  deadline     Deadline? @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("reminders")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid @map("admin_id")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // e.g. "PROMOTE_HOD", "DEMOTE_HOD", "SUSPEND_USER"
  targetUser String?  @map("target_user") // Target user email or name
  timestamp  DateTime @default(now()) @map("timestamp")

  @@map("audit_logs")
}
