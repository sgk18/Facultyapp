datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HOD
  FACULTY

  @@map("role_type")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}



model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  code      String     @unique // e.g. "CS", "MATH"
  users     User[]
  deadlines Deadline[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  supabaseUserId      String         @unique @db.Uuid @map("supabase_user_id")
  email               String         @unique
  fullName            String         @map("full_name")
  role                Role           @default(FACULTY)
  departmentId        String         @db.Uuid @map("department_id")
  department          Department     @relation(fields: [departmentId], references: [id])
  avatarUrl           String?        @map("avatar_url")
  deadlines           Deadline[]     @relation("CreatedDeadlines")
  notifications       Notification[]
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  employeeCode        String?        @map("employee_code")
  isSuspended         Boolean        @default(false) @map("is_suspended")
  gmailSyncEnabled    Boolean        @default(false) @map("gmail_sync_enabled")
  calendarSyncEnabled Boolean        @default(false) @map("calendar_sync_enabled")
  notificationEnabled Boolean        @default(true) @map("notification_enabled")
  fcmToken            String?        @map("fcm_token")
  platform            String?        @map("platform")
  googleId            String?        @unique @map("google_id")
  googleAccessToken   String?        @map("google_access_token")
  googleRefreshToken  String?        @map("google_refresh_token")
  auditLogs           AuditLog[]

  @@map("users")
}

model Deadline {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  description     String
  dueDate         DateTime        @map("due_date")
  priority        Priority        @default(MEDIUM)
  ownerId         String          @db.Uuid @map("owner_id")
  owner           User            @relation("CreatedDeadlines", fields: [ownerId], references: [id], onDelete: Cascade)
  departmentId    String          @db.Uuid @map("department_id")
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isCompleted     Boolean         @default(false) @map("is_completed")
  status          String          @default("ACTIVE")
  notifications   Notification[]
  reminderEnabled Boolean         @default(false) @map("reminder_enabled")
  reminderTime    DateTime?       @map("reminder_time")
  repeatType      String?         @map("repeat_type")
  syncToCalendar  Boolean         @default(false) @map("sync_to_calendar")
  googleEventId   String?         @unique @map("google_event_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("deadlines")
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  body              String
  type              String    @default("DEADLINE")
  isRead            Boolean   @default(false) @map("is_read")
  relatedDeadlineId String?   @db.Uuid @map("related_deadline_id")
  relatedDeadline   Deadline? @relation(fields: [relatedDeadlineId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid @map("admin_id")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // e.g. "PROMOTE_HOD", "DEMOTE_HOD", "SUSPEND_USER"
  targetUser String?  @map("target_user") // Target user email or name
  timestamp  DateTime @default(now()) @map("timestamp")

  @@map("audit_logs")
}
